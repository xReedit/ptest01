<?php
// Copiar a `asistencia_secrets.php` (mismo directorio, NO versionar) y completar.
// Configuracion del modulo de Control de Asistencia.
//
// El POS no se conecta a la BD `rrhh`: habla con la API central de Recursos
// Humanos por HTTPS. 30 de las 45 sedes corren servidor local y no tienen (ni
// deben tener) acceso directo al MySQL de rrhh.

// URL base de la API de RRHH, sin barra final.
//   dev:  http://localhost:10323/api-rrhh
//   prod: https://papaya.com.pe/api-rrhh
define('ASISTENCIA_API_URL', 'http://localhost:10323/api-rrhh');

// Secreto compartido para firmar el token que identifica empresa+sede (HS256).
// DEBE coincidir con POS_SHARED_SECRET del .env de la API de RRHH.
// Generar aleatorio largo:  php -r "echo bin2hex(random_bytes(32));"
define('ASISTENCIA_API_SECRET', 'CAMBIAR_mismo_valor_que_POS_SHARED_SECRET');

// Segundos de espera antes de dar la API por caida. Corto a proposito: si la
// central no responde, el panel debe avisar rapido y no dejar la pantalla colgada.
define('ASISTENCIA_API_TIMEOUT', 8);
