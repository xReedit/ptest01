<?php
// Lectura de facturas con IA (Compras). Plan: plan/COMPRAS-LECTURA-FACTURA-PLAN.md
//
// USO: copia este archivo como  private/compras_secrets.php  y pon tu clave real alli.
//      NUNCA pongas la clave real en este .example (esta carpeta se puede descargar por web).
//
// Si el servidor define una variable de entorno con el mismo nombre, esa tiene prioridad.

// Proveedor de IA: 'claude' | 'openai' | 'gemini'
define('FACTURA_IA_PROVEEDOR', 'claude');

// Modelo con vision del proveedor elegido
//   claude  -> ej: 'claude-sonnet-5'  o  'claude-haiku-4-5-20251001' (mas barato)
//   openai  -> el modelo con vision que uses en tu cuenta
//   gemini  -> el modelo con vision que uses en tu cuenta
define('FACTURA_IA_MODELO', 'claude-sonnet-5');

// Clave (API key) del proveedor elegido
//   claude  -> https://console.anthropic.com  (Settings > API Keys)
//   openai  -> https://platform.openai.com/api-keys
//   gemini  -> https://aistudio.google.com/apikey
define('FACTURA_IA_API_KEY', 'PEGA_AQUI_TU_CLAVE');

// Maximo de lecturas por sede por dia (control de costo)
define('FACTURA_IA_LIMITE_DIA', 50);

// Segundos maximos esperando la respuesta de la IA
define('FACTURA_IA_TIMEOUT', 60);

// La foto/PDF de la factura NO se guarda: se lee en el momento y PHP la borra al terminar la peticion.
