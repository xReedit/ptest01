<?php
// Ejemplo de private/vision_secrets.php (Camaras IA). El real ya existe desde F1 con VISION_URL y VISION_SHARED_SECRET:
// NO lo reemplaces con este archivo, solo agregale VISION_INTERNO_KEY. private/ es publico en nginx: solo constantes.
define('VISION_URL', '');             // servidor Go (https://...), el mismo del SSO (log.php op=-4003)
define('VISION_SHARED_SECRET', '');   // firma del SSO = PV_SECRETO_SSO del servidor Go
// F2 (Control de pedidos y Anfitrion, bdphp/log_vision.php): clave del consumidor "legacy" de /interno/v1
// = la de "legacy=<clave>" en PV_INTERNO_CLAVES del servidor Go (32 caracteres o mas). Vacia: no se muestra nada.
define('VISION_INTERNO_KEY', '');
// Opcional: otra URL para llamar al servidor Go desde este PHP (red interna). Sin ella se usa VISION_URL.
// define('VISION_INTERNO_URL', 'http://IP-SERVIDOR-GO:8080');
